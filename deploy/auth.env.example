# Keep the real file at ~/.config/etv-dashboard/auth.env with mode 600.
# Administrator credentials permit annotation and topic-review writes.
ETV_DASHBOARD_USERNAME=supervisor
ETV_DASHBOARD_PASSWORD=replace-with-a-long-private-administrator-password

# Reviewer credentials permit all read and download operations but no writes.
ETV_DASHBOARD_REVIEW_USERNAME=reviewer
ETV_DASHBOARD_REVIEW_PASSWORD=replace-with-a-separate-long-review-password
