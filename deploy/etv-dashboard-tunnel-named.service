[Unit]
Description=Permanent Cloudflare tunnel for the ETV dashboard
After=network-online.target etv-dashboard.service
Wants=network-online.target etv-dashboard.service

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env cloudflared tunnel --no-autoupdate run --token-file %h/.config/etv-dashboard/tunnel.token
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
