[Unit]
Description=Temporary public Cloudflare tunnel for the ETV dashboard
After=network-online.target etv-dashboard.service
Wants=network-online.target etv-dashboard.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --url http://127.0.0.1:8321 --no-autoupdate
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
