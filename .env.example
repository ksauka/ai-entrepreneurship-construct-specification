# Copy to .env (gitignored) and fill in.

# --- Stage 2A.5: full multi-model specification experiment ---
OPENAI_API_KEY=sk-your-key-here
# Optional; defaults to the pinned GPT-4.1 nano snapshot
OPENAI_MODEL=gpt-4.1-nano-2025-04-14
# Optional OpenAI-compatible endpoint override
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-sonnet-5

# Local Ollama overrides used with --local
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Optional SSH workbench used for a separate research-grade local model
WORKBENCH_SSH_HOST=actual-hostname-or-ip
WORKBENCH_SSH_USER=actual-username
WORKBENCH_SSH_PORT=22
WORKBENCH_SSH_KEY=/home/suvh/.ssh/id_ed25519
WORKBENCH_OLLAMA_PORT=11437
WORKBENCH_LOCAL_PORT=11435
WORKBENCH_MODEL=gemma4:31b
# Optional user-owned model store when the system store is not readable.
WORKBENCH_OLLAMA_MODELS=/home/remote-user/.ollama/models

# --- Stage 2B: Neo4j knowledge graph (docker-compose.yml, scripts/build_graph.py) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=etv_v2_password
